# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autorent
DATABASE_URL=postgresql+asyncpg://<user>:<password>@db:5432/<db_name>

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://<user>:<password>@rabbitmq:5672/
RABBITMQ_EXCHANGE=autorent.events
RABBITMQ_QUEUE=autorent.events.queue
WORKER_CONCURRENCY=4   # number of messages processed concurrently per worker

# Logging
LOG_FILE=logs/app.log
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
